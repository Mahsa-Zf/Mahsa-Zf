, 6)), labels=classes)\n    plt.colorbar(ctx)\n    plt.show()\n\n    \nprint('Using TensorFlow version', tf.__version__)","metadata":{"execution":{"iopub.status.busy":"2022-07-03T11:05:16.49835Z","iopub.execute_input":"2022-07-03T11:05:16.498794Z","iopub.status.idle":"2022-07-03T11:05:18.593289Z","shell.execute_reply.started":"2022-07-03T11:05:16.498746Z","shell.execute_reply":"2022-07-03T11:05:18.591839Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"[List of content](#sections)\n<a id=\"2\"></a>\n## **<span style=\"color:#F26300;\">2. Import Data</span>**\n\n**We are going to:**\n1. Import the Tweet Emotion dataset\n2. Creat train, validation and test sets\n3. Extract tweets and labels from the examples","metadata":{}},{"cell_type":"code","source":"dataset = nlp.load_dataset('emotion')","metadata":{"execution":{"iopub.status.busy":"2022-07-03T11:06:32.004547Z","iopub.execute_input":"2022-07-03T11:06:32.005987Z","iopub.status.idle":"2022-07-03T11:06:39.539124Z","shell.execute_reply.started":"2022-07-03T11:06:32.005932Z","shell.execute_reply":"2022-07-03T11:06:39.538052Z"},"_kg_hide-output":true,"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"dataset","metadata":{"execution":{"iopub.status.busy":"2022-07-03T11:06:46.130801Z","iopub.execute_input":"2022-07-03T11:06:46.131214Z","iopub.status.idle":"2022-07-03T11:06:46.140317Z","shell.execute_reply.started":"2022-07-03T11:06:46.131182Z","shell.execute_reply":"2022-07-03T11:06:46.139243Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train = dataset['train']\nval = dataset['validation']\ntest = dataset['test']","metadata":{"execution":{"iopub.status.busy":"2022-07-03T11:06:56.410729Z","iopub.execute_input":"2022-07-03T11:06:56.411112Z","iopub.status.idle":"2022-07-03T11:06:56.41661Z","shell.execute_reply.started":"2022-07-03T11:06:56.411082Z","shell.execute_reply":"2022-07-03T11:06:56.415676Z"},"trusted":tr